<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Target Jellyfin version. Default: Jellyfin 12 (.NET 10).
      For Jellyfin 10.11 (.NET 9): dotnet publish -c Release -p:JellyfinVersion=10.11.0

      Plugin versions: 2.x is built for Jellyfin 12, 1.x for Jellyfin 10.11.
    -->
    <JellyfinVersion Condition="'$(JellyfinVersion)' == ''">12.0.0</JellyfinVersion>
    <TargetFramework Condition="$(JellyfinVersion.StartsWith('10.'))">net9.0</TargetFramework>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>

    <PluginVersion Condition="'$(PluginVersion)' == '' And $(JellyfinVersion.StartsWith('10.'))">1.0.0.0</PluginVersion>
    <PluginVersion Condition="'$(PluginVersion)' == ''">2.0.0.0</PluginVersion>

    <RootNamespace>Jellyfin.Plugin.SeriesSubtitles</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.SeriesSubtitles</AssemblyName>
    <AssemblyVersion>$(PluginVersion)</AssemblyVersion>
    <FileVersion>$(PluginVersion)</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration/configPage.html" />
    <EmbeddedResource Include="Configuration/configPage.html" />
  </ItemGroup>

</Project>
